<?xml version="1.0" encoding="utf-8"?>
<!--
    The gateway only ever binds loopback, and cleartext HTTP is how every
    OpenAI/Anthropic client is pointed at it. Restricting the exemption to
    localhost keeps the rest of the app subject to the platform default.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
